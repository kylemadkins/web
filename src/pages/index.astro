---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import Post from "../components/Post.astro";
import Project from "../components/Project.astro";

const posts = (await getCollection("blog")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const projects = (await getCollection("projects")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="relative py-32">
        <!-- <img class="absolute w-1/2 -top-[10%]" src="./3d.png" /> -->
        <div class="small-container">
          <h1 data-aos="fade-up" class="font-decorative font-bold">
            Hi, I'm Kyle.
          </h1>
          <p data-aos="fade-up" class="fade-in-up mt-8 text-xl leading-[1.6]">
            I'm an experienced developer with a talent for blending technical
            ability and creative expression to create unique interactive and
            immersive experiences.
          </p>
          <a
            data-aos="fade-up"
            href="/about"
            class="font-decorative button rounded-full border-2 border-orange hover:bg-transparent bg-orange hover:border-black mt-8 inline-block hover:text-black text-white font-bold px-6 py-4 text-base"
            >Read My Bio</a
          >
        </div>
      </section>

      <section class="angled-top-section bg-zinc-100">
        <div class="wide-container">
          <h2
            data-aos="fade-up"
            class="font-decorative uppercase font-bold mb-8 text-black"
          >
            Latest Posts
          </h2>
          <ul class="sm:grid sm:grid-cols-2 gap-16">
            {
              posts.slice(0, 3).map((post: any) => (
                <li data-aos="fade-up" class="mb-12">
                  <Post
                    slug={post.slug}
                    heroImage={post.data.heroImage}
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    class="text-black hover:text-black"
                  />
                </li>
              ))
            }
          </ul>

          <a
            data-aos="fade-up"
            href="/blog"
            class="button font-decorative rounded-full border-2 border-orange hover:bg-transparent bg-orange hover:border-black mt-8 inline-block hover:text-black text-white font-bold px-6 py-4 text-base"
            >View More</a
          >
        </div>
      </section>

      <section class="wide-container py-24">
        <h2 data-aos="fade-up" class="font-decorative uppercase font-bold mb-8">
          Recent Projects
        </h2>
        <ul class="sm:grid sm:grid-cols-2 gap-16">
          {
            projects.slice(0, 3).map((post: any) => (
              <li data-aos="fade-up" class="mb-12">
                <Project
                  slug={post.slug}
                  heroImage={post.data.heroImage}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  class="text-black hover:text-black"
                />
              </li>
            ))
          }
        </ul>

        <a
          data-aos="fade-up"
          href="/projects"
          class="button font-decorative rounded-full border-2 border-orange hover:bg-transparent bg-orange hover:border-black mt-8 inline-block hover:text-black text-white font-bold px-6 py-4 text-base"
          >View More</a
        >
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .angled-top-section {
    @apply pt-48 pb-32;
    -webkit-clip-path: polygon(0 15vh, 100% 0, 100% 100%, 0 100%);
    clip-path: polygon(0 15vh, 100% 0, 100% 100%, 0 100%);
  }

  .button[data-aos^="fade"][data-aos^="fade"] {
    transition-property: opacity, transform, background-color, color,
      border-color;
  }
</style>
