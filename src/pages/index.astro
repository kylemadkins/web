---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import Post from "../components/Post.astro";
import Project from "../components/Project.astro";

const posts = (await getCollection("blog")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const projects = (await getCollection("projects")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="small-container py-32">
        <h1 data-aos="fade-up" class="font-oswald font-bold">Hi, I'm Kyle.</h1>
        <p data-aos="fade-up" class="fade-in-up mt-8 text-xl leading-[1.6]">
          I'm an experienced programmer interested in the creative application
          of technology&mdash;game development, virtual and augmented reality,
          graphics, art, you name it. Welcome to my little internet hot dog
          stand.
        </p>
        <a
          data-aos="fade-up"
          href="/about"
          class="fade-in-up tracking-widest border-black border-2 mt-8 inline-block text-black hover:text-black font-bold px-6 py-4 uppercase font-archivo-narrow text-sm"
          >About Me</a
        >
      </section>

      <section class="wide-container">
        <h2
          data-aos="fade-up"
          class="text-3xl uppercase font-bold font-oswald mb-4"
        >
          Latest Posts
        </h2>
        <ul class="sm:grid sm:grid-cols-2 gap-16">
          {
            posts
              .slice(0, 3)
              .map((post: any) => (
                <Post
                  slug={post.slug}
                  heroImage={post.data.heroImage}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                />
              ))
          }
        </ul>
      </section>

      <section class="wide-container py-24">
        <h2
          data-aos="fade-up"
          class="text-3xl uppercase font-bold font-oswald mb-4"
        >
          Recent Projects
        </h2>
        <ul class="sm:grid sm:grid-cols-2 gap-16">
          {
            projects
              .slice(0, 3)
              .map((post: any) => (
                <Project
                  slug={post.slug}
                  heroImage={post.data.heroImage}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                />
              ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
