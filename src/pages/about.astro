---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const desc = `
Hiya, I'm Kyle. I'm an experienced programmer with an interest in the
creative application of technology&mdash;simulations, virtual and
augmented reality, graphics, digital art, game development, you name
it.`;
---

<html lang="en">
  <head>
    <BaseHead title="Kyle Adkins" description={desc} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        @apply text-black;
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article class="py-16">
        <div class="prose">
          <div class="text-center mb-8">
            <h1
              data-aos="fade-up"
              class="text-5xl mb-8 font-decorative font-bold"
            >
              Who am I?
            </h1>
            <hr />
          </div>
          <p data-aos="fade-up">
            I'm Kyle Adkins. I'm a developer with {
              new Date().getFullYear() - 2017
            }+ years of industry experience.
          </p>
          <p data-aos="fade-up">
            I'm currently building internal tools that power personalized
            recommendations on <a href="https://paramountplus.com">Paramount+</a
            > as part of the Applied Machine Learning Group.
          </p>
          <p data-aos="fade-up">
            Before that, I brought the visions of world-class designers to life
            for
            <a href="https://few.io">Few</a>, including an <a
              href="https://few.io/launches/crystal-bridges"
              >interactive timeline</a
            > of the Constitution of the United States, which was on display at the
            Crystal Bridges Museum of American Art.
          </p>
          <p data-aos="fade-up">
            Outside of my current job, I've been exploring 3D game design and
            development. When I'm not at a computer, I'm typically reading,
            painting, playing games, cracking jokes, and experiencing new
            things.
          </p>
          <p data-aos="fade-up">
            If you'd like to work with me or ask me a question, feel free to
            contact me. I'm happy to help where I can. Thanks for stopping by!
          </p>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
