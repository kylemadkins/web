        >GitHub</a
      >
      <a
        class="underline"
        href="https://www.linkedin.com/in/kylemadkins"
        target="_blank"
      >
        LinkedIn
      </a>
      <a class="underline" href="/rss.xml" target="_blank">RSS</a>
      <a class="underline" href="mailto:kylemadkins@gmail.com">Email</a> -->
    </div>
  </div>
  <div
    class="border-t-[1px] border-zinc-800 bg-zinc-900 text-zinc-500 py-8 text-sm"
  >
    &copy; {today.getFullYear()} Kyle Adkins. All rights reserved.
  </div>
</footer>
<style>
  footer {
    text-align: center;
  }
  .social-links {
    display: flex;
    justify-content: center;
    @apply gap-4 mt-8;
  }
  .social-links a,
  .social-links a:hover {
    @apply text-sm text-zinc-200;
  }
  .contact {
    @apply bg-zinc-900;
  }
</style>
<script>
  // @ts-ignore
  import AOS from "aos";
  window.onload = () => AOS.init();
</script>
