---
const today = new Date();
---

<footer>
  <div class="contact py-36">
    <h1 data-aos="fade-up" class="font-candal text-zinc-100">Get in Touch</h1>
    <div data-aos="fade-up" class="social-links">
      <a href="https://www.linkedin.com/in/kylemadkins"
        ><svg
          class="h-5"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0.410653 7.96902H5.58936V24H0.410653V7.96902ZM3.00143 0C4.6564 0 6 1.29445 6 2.88917C6 4.48434 4.65639 5.77877 3.00143 5.77877C1.33986 5.77877 0 4.48435 0 2.88917C0 1.29445 1.33985 0 3.00143 0Z"
            fill="currentColor"></path>
          <path
            d="M8 7.41163H12.9188V9.67939H12.9892C13.6734 8.37528 15.3477 7 17.8442 7C23.0398 7 24 10.4348 24 14.9024V24H18.8691V15.9331C18.8691 14.0094 18.8362 11.5346 16.2027 11.5346C13.5327 11.5346 13.1253 13.6313 13.1253 15.7954V24H8V7.41163Z"
            fill="currentColor"></path>
        </svg></a
      >
      <a href="mailto:kylemadkins@gmail.com"
        ><svg class="h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          ><g fill="currentColor" class="nc-icon-wrapper"
            ><path
              d="M1.4,10.8l2.577,1.952,9-4L6,14.251V21a1,1,0,0,0,1.765.643l3.13-3.719L17.4,22.8a1,1,0,0,0,1.581-.6l4-20a1,1,0,0,0-1.352-1.125l-20,8A1,1,0,0,0,1.4,10.8Z"
              fill="currentColor"></path></g
          ></svg
        ></a
      >
    </div>
  </div>
</footer>
<style>
  footer {
    text-align: center;
  }
  .social-links {
    display: flex;
    justify-content: center;
    @apply gap-6 mt-8;
  }
  .social-links a {
    @apply p-3 rounded-full bg-zinc-200 text-black;
  }
  .social-links a,
  .social-links a:hover {
    @apply text-black;
  }
  .contact {
    @apply bg-zinc-900;
    --s: 82px; /* control the size*/
    --c1: #18181b;
    --c2: #374151;
    --c3: #27272a;

    --_g: var(--c3) 0 120deg, #0000 0;
    background: conic-gradient(from -60deg at 50% calc(100% / 3), var(--_g)),
      conic-gradient(from 120deg at 50% calc(200% / 3), var(--_g)),
      conic-gradient(
        from 60deg at calc(200% / 3),
        var(--c3) 60deg,
        var(--c2) 0 120deg,
        #0000 0
      ),
      conic-gradient(from 180deg at calc(100% / 3), var(--c1) 60deg, var(--_g)),
      linear-gradient(
        90deg,
        var(--c1) calc(100% / 6),
        var(--c2) 0 50%,
        var(--c1) 0 calc(500% / 6),
        var(--c2) 0
      );
    background-size: calc(1.732 * var(--s)) var(--s);
  }
</style>
<script>
  // @ts-ignore
  import AOS from "aos";
  window.onload = () => AOS.init();
</script>
