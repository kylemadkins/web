  <div class="contact py-36">
    <h1
      data-aos="fade-up"
      class="font-bold uppercase text-zinc-100 font-oswald"
    >
      Get in Touch
    </h1>
    <div data-aos="fade-up" class="social-links">
      <a href="https://www.linkedin.com/in/kylemadkins"
        ><svg class="h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          ><g fill="currentColor" class="nc-icon-wrapper"
            ><path
              fill="currentColor"
              d="M23,0H1C0.4,0,0,0.4,0,1v22c0,0.6,0.4,1,1,1h22c0.6,0,1-0.4,1-1V1C24,0.4,23.6,0,23,0z M7.1,20.5H3.6V9h3.6 V20.5z M5.3,7.4c-1.1,0-2.1-0.9-2.1-2.1c0-1.1,0.9-2.1,2.1-2.1c1.1,0,2.1,0.9,2.1,2.1C7.4,6.5,6.5,7.4,5.3,7.4z M20.5,20.5h-3.6 v-5.6c0-1.3,0-3-1.8-3c-1.9,0-2.1,1.4-2.1,2.9v5.7H9.4V9h3.4v1.6h0c0.5-0.9,1.6-1.8,3.4-1.8c3.6,0,4.3,2.4,4.3,5.5V20.5z"
            ></path></g
          ></svg
        ></a
      >
      <a href="mailto:kylemadkins@gmail.com"
        ><svg class="h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          ><g fill="currentColor" class="nc-icon-wrapper"
            ><path
              d="M12,.5a11.5,11.5,0,1,0,4.6,22.043l1.374-.6-1.2-2.749-1.375.6A8.416,8.416,0,0,1,12,20.5,8.5,8.5,0,1,1,20.5,12v1a1.5,1.5,0,0,1-3,0V6.5h-3v.607a5.5,5.5,0,1,0,1.21,8.941A4.486,4.486,0,0,0,23.5,13V12A11.513,11.513,0,0,0,12,.5Zm0,14A2.5,2.5,0,1,1,14.5,12,2.5,2.5,0,0,1,12,14.5Z"
              fill="currentColor"></path></g
          ></svg
        ></a
      >
    </div>
  </div>
</footer>
<style>
  footer {
    text-align: center;
  }
  .social-links {
    display: flex;
    justify-content: center;
    @apply gap-6 mt-8;
  }
  .social-links a {
    @apply p-3 rounded-full bg-zinc-200 text-black;
  }
  .social-links a,
  .social-links a:hover {
    @apply text-black;
  }
  .contact {
    @apply bg-zinc-900;
    --s: 82px; /* control the size*/
    --c1: #18181b;
    --c2: #374151;
    --c3: #27272a;

    --_g: var(--c3) 0 120deg, #0000 0;
    background: conic-gradient(from -60deg at 50% calc(100% / 3), var(--_g)),
      conic-gradient(from 120deg at 50% calc(200% / 3), var(--_g)),
      conic-gradient(
        from 60deg at calc(200% / 3),
        var(--c3) 60deg,
        var(--c2) 0 120deg,
        #0000 0
      ),
      conic-gradient(from 180deg at calc(100% / 3), var(--c1) 60deg, var(--_g)),
      linear-gradient(
        90deg,
        var(--c1) calc(100% / 6),
        var(--c2) 0 50%,
        var(--c1) 0 calc(500% / 6),
        var(--c2) 0
      );
    background-size: calc(1.732 * var(--s)) var(--s);
  }
</style>
<script>
  // @ts-ignore
  import AOS from "aos";
  window.onload = () => AOS.init();
</script>
