---
import FormattedDate from "./FormattedDate.astro";

interface Props {
  slug: string;
  heroImage?: string;
  title: string;
  description: string;
  pubDate: Date;
  class: string;
}

const {
  slug,
  heroImage,
  title,
  description,
  pubDate,
  class: className,
} = Astro.props;
---

<a href={`/projects/${slug}/`} class:list={[className]}>
  <img src={heroImage} alt="" />
  <p class="uppercase font-archivo-narrow date text-inherit">
    <FormattedDate date={pubDate} />
  </p>
  <h4 class="title font-bold text-inherit">{title}</h4>
  <p class="desc text-inherit">{description}</p>
  <p
    class="read-more text-inherit uppercase font-archivo-narrow text-sm font-bold"
  >
    View Project &rarr;
  </p>
</a>

<style>
  .title,
  .desc,
  .date,
  .read-more {
    margin: 0 0 1rem 0;
    padding: 0;
    line-height: 1;
  }

  .date {
    margin-top: 2rem;
  }

  .read-more {
    margin-top: 2rem;
  }

  img {
    aspect-ratio: 16/9;
    object-fit: cover;
  }
</style>
